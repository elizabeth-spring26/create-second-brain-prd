# Copy this file to .env and fill in your values
# NEVER commit .env — it's already in .gitignore

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic (get from console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub (get from github.com → Settings → Developer settings → Personal access tokens → Fine-grained)
# Permissions needed: Contents (read & write) on this repo only
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=888lizabeth/create-second-brain-prd
USE_GITHUB_API=true    # set this in Railway — leave it unset for local dev

# ── Google (Phase 5 — add after OAuth setup) ──────────────────────────────────
# No keys go here — Google uses a credentials.json file instead
# Download it from Google Cloud Console and save to: .secrets/credentials.json

# ── Telegram (reminders + two-way chat) ───────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token below
# 2. Message your new bot once from Telegram
# 3. Run: python server/telegram_get_chat_id.py   → copy the chat_id below
#    (do this BEFORE setting the webhook — see step 5)
# 4. Generate a random secret for TELEGRAM_WEBHOOK_SECRET, e.g.:
#    python -c "import secrets; print(secrets.token_hex(24))"
# 5. After deploying to Vercel, run:
#    python server/telegram_set_webhook.py https://your-app.vercel.app
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
TELEGRAM_WEBHOOK_SECRET=...

# ── Optional / Later phases ───────────────────────────────────────────────────
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_NOTIFICATION_CHANNEL=#general
